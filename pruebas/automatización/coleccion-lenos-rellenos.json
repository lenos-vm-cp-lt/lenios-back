      "name": "https://lenios-back.onrender.com/api/v1/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"No responde con error 500 (defecto corregido)\", function () {\r",
              "    pm.response.to.not.have.status(500);\r",
              "});\r",
              "\r",
              "pm.test(\"Responde con error controlado (400 o 401)\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 401]);\r",
              "});\r",
              "\r",
              "pm.test(\"No expone el nombre del modelo interno en la respuesta\", function () {\r",
              "    const responseText = pm.response.text();\r",
              "    pm.expect(responseText).to.not.include(\"Usuario\");\r",
              "    pm.expect(responseText).to.not.include(\"Cast to string failed\");\r",
              "});\r",
              "\r",
              "pm.test(\"No se autenticó con el payload malicioso\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.not.have.property('token');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
